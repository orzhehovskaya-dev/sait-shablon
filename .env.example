# =====================================================================
# Скопіюй цей файл у .env.local (локально) або додай змінні у Vercel →
# Project → Settings → Environment Variables. Секрети НЕ мають префікса NEXT_PUBLIC_.
# Покрокова інструкція — docs/SETUP.md
# =====================================================================

# Адреса сайту (без / в кінці)
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Supabase (база даних і вхід в адмінку) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- WayForPay ---
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_SECRET_KEY=
# Домен, зареєстрований у WayForPay для цього мерчанта (без https://)
WAYFORPAY_MERCHANT_DOMAIN=example.com
# Валюта списання: EUR (якщо дозволено для твого ФОП) або UAH
WAYFORPAY_CURRENCY=EUR
# Лише якщо WAYFORPAY_CURRENCY=UAH: курс перерахунку євро в гривні.
# auto — офіційний курс НБУ, оновлюється автоматично (рекомендовано); або число, напр. 50.31
WAYFORPAY_EUR_RATE=auto

# Скільки хвилин слот утримується під час оплати
BOOKING_HOLD_MINUTES=20

# --- Apple iCloud Calendar (CalDAV) ---
ICLOUD_APPLE_ID=your-apple-id@icloud.com
# Пароль застосунку з appleid.apple.com (НЕ основний пароль Apple ID)
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Календар, куди сайт записує оплачені зустрічі (створи його в «Календарі» на iPhone)
ICLOUD_BOOKING_CALENDAR=Мої зустрічі
# Календарі, які НЕ враховувати як зайнятість (через кому), напр.: Дні народження,Свята
ICLOUD_IGNORE_CALENDARS=
# Чи блокують події «на весь день» бронювання (true/false)
ICLOUD_ALLDAY_BLOCKS=true

# --- Zoom (Server-to-Server OAuth app) ---
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Запасний варіант без API: постійне посилання на твою кімнату
ZOOM_FALLBACK_LINK=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# id ТВОГО особистого чату з ботом (додатне число)
TELEGRAM_CHAT_ID=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Твоє Ім'я <hello@example.com>
EMAIL_REPLY_TO=

# --- Планувальник ---
# Довгий випадковий рядок: openssl rand -hex 32
CRON_SECRET=

# --- Аналітика (необов'язково) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
